---
import { personalInfo, socialLinks } from "../data/resume";
---

<section id="contact" class="px-6 py-28">
  <div class="mx-auto max-w-3xl text-center reveal">
    <h2 class="font-heading text-4xl font-bold text-white md:text-5xl">
      Contact
    </h2>
    <p class="mx-auto mt-5 max-w-md text-lg text-[#888]">
      Feel free to reach out.
    </p>

    <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={`mailto:${personalInfo.email}`}
        class="card card-interactive flex items-center gap-3 rounded-full px-8 py-4 text-[#ccc] transition-colors hover:text-white"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
        {personalInfo.email}
      </a>
      {
        socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card card-interactive flex items-center gap-3 rounded-full px-8 py-4 text-[#ccc] transition-colors hover:text-white"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d={link.icon} />
            </svg>
            {link.name}
          </a>
        ))
      }
    </div>
  </div>
</section>
