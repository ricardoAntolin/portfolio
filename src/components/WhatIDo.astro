---
const services = [
  {
    title: "Mobile Development",
    description:
      "Native and cross-platform apps for iOS and Android. From architecture to the App Store.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />`,
  },
  {
    title: "Backend Systems",
    description:
      "Scalable services in Go, Elixir, Ruby, and Python. API design, microservices, and data pipelines.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" />`,
  },
  {
    title: "Engineering Leadership",
    description:
      "Building and growing engineering teams. Defining processes, mentoring, and driving technical strategy.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />`,
  },
  {
    title: "Product Engineering",
    description:
      "Data-driven development focused on user impact. Amplitude, A/B testing, and shipping what matters.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />`,
  },
];
---

<section id="whatido" class="px-6 py-28">
  <div class="mx-auto max-w-3xl">
    <div class="reveal flex items-center gap-4 mb-14">
      <h2 class="font-heading text-3xl font-bold accent-text">What I Do</h2>
      <div class="section-divider flex-1"></div>
    </div>

    <div class="reveal-stagger grid gap-5 sm:grid-cols-2">
      {
        services.map((service) => (
          <div class="reveal-item card card-interactive rounded-2xl p-6">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[#e8735a]/10">
              <svg class="h-6 w-6 text-[#e8735a]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <Fragment set:html={service.icon} />
              </svg>
            </div>
            <h3 class="font-heading text-lg font-bold text-white">
              {service.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[#888]">
              {service.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
