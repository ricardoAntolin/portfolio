---
import { experience, skills } from "../data/resume";
---

<section id="experience" class="px-6 py-28">
  <div class="mx-auto max-w-5xl">
    <div class="reveal flex items-center gap-4 mb-14">
      <h2 class="font-heading text-3xl font-bold accent-text">Experience & Skills</h2>
      <div class="section-divider flex-1"></div>
    </div>

    <div class="flex flex-col gap-16 lg:flex-row lg:gap-12">
      <!-- Left: Experience timeline -->
      <div class="lg:w-3/5">
        <div class="relative">
          <div class="timeline-line absolute top-2 bottom-2 left-[7px] w-px rounded-full"></div>

          <div class="space-y-8">
            {
              experience.map((exp) => (
                <div class="reveal relative pl-10">
                  <div class="absolute top-5 left-[3px] h-[9px] w-[9px] rounded-full border-2 border-[#e8735a] bg-[#1a1a1a]" />

                  <div class="card card-interactive rounded-2xl p-6">
                    <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
                      <div>
                        <h3 class="font-heading text-lg font-bold text-white">
                          {exp.company}
                        </h3>
                        <p class="mt-1 text-sm text-[#999]">
                          {exp.role}
                        </p>
                      </div>
                      <span class="mt-1 shrink-0 text-xs text-[#666] sm:mt-0">
                        {exp.period}
                      </span>
                    </div>
                    <p class="mt-3 text-sm leading-relaxed text-[#888]">
                      {exp.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Right: Skills (sticky on desktop) -->
      <div class="lg:w-2/5">
        <div class="lg:sticky lg:top-24">
          <h3 class="reveal mb-8 font-heading text-xl font-bold text-white">Tech Stack</h3>

          <div class="space-y-8">
            {
              skills.map((category) => (
                <div>
                  <h4 class="reveal mb-3 font-heading text-xs font-medium tracking-widest text-[#666] uppercase">
                    {category.name}
                  </h4>
                  <div class="reveal-stagger grid grid-cols-2 gap-2">
                    {category.skills.map((skill) => (
                      <div class="skill-card card card-interactive reveal-item flex items-center gap-2.5 rounded-lg px-3 py-2.5">
                        <i class={`${skill.icon} skill-icon text-xl`} />
                        <span class="text-sm text-[#bbb]">
                          {skill.name}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
