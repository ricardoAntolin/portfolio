---
import { socialLinks } from "../data/resume";
const year = new Date().getFullYear();
---

<footer class="border-t border-[#2a2a2a] px-6 py-10">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 sm:flex-row sm:justify-between">
    <span class="font-heading text-sm font-bold accent-text">RA</span>
    <div class="flex items-center gap-5">
      {
        socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#555] transition-colors hover:text-[#ccc]"
            aria-label={link.name}
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d={link.icon} />
            </svg>
          </a>
        ))
      }
    </div>
    <span class="text-xs text-[#555]">&copy; {year} Ricardo Antolin</span>
  </div>
</footer>
